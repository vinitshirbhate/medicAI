# MongoDB Atlas — record of patients and observations for the Sundara Command demo.
# Copy to backend/.env (gitignored) and fill in the password from the Atlas connect dialog.
MONGODB_URI=mongodb+srv://arhantanilbagde_db_user:<db_password>@cluster0.gzbjbhd.mongodb.net/?appName=Cluster0
MONGODB_PASSWORD=
MONGODB_DB=sundara_command
MONGODB_TIMEOUT_MS=5000
# Set to 0 for a fully offline demo; the API then seeds the same five patients into SQLite only.
MONGODB_ENABLED=1

# Advisory second opinion (optional).
OPENROUTER_API_KEY=
